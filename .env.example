# ---------------------------------------------------------------
# Watson Decoration — environment variables
# Copy to .env.local for local development. On Vercel, add the same
# keys under Project Settings -> Environment Variables.
# NEVER commit real values.
# ---------------------------------------------------------------

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/watson-decoration?retryWrites=true&w=majority

# Initial administrator — only read by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Secret used to sign admin session tokens (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET=

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Image / video storage (Cloudinary). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Find it in Cloudinary Console -> Dashboard -> "API environment variable".
# Leave empty in local development to store uploads in /public/uploads (NOT for production).
IMAGE_STORAGE_CONFIGURATION=
